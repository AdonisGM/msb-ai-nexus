# Nexus — THÊM cạnh cấu hình đang chạy, không thay thế nó.
#
# Đặt thành một tệp riêng, ví dụ /etc/nginx/conf.d/nexus.conf. An toàn vì hai
# tên miền dưới đây không trùng tên nào trong cấu hình home. Nếu có trùng thì
# `nginx -t` vẫn báo thành công và chỉ ghi một dòng "conflicting server name",
# rồi tệp nào nạp trước thì thắng — mọi thứ trông vẫn xanh trong khi tên miền
# trỏ sai chỗ.
#
# KHÔNG khai default_server ở đây. Cấu hình home đã có một cặp trả 444 cho mọi
# tên miền lạ; thêm cặp nữa là `nginx -t` báo "duplicate default server" và
# nginx không khởi động lại được.
#
# Bố cục giống home: Cloudflare đứng trước và lo chứng chỉ thật cho trình
# duyệt, nginx ở đây dùng chứng chỉ tự ký cho chặng Cloudflare ↔ máy chủ. Ở
# Cloudflare để chế độ "Full", KHÔNG phải "Full (strict)".
#
# Hai container nghe trên 127.0.0.1 cổng 4510 và 4511.
#
# Không có khối map $http_upgrade, và không cần: web là trang tĩnh do nginx
# trong container phục vụ, API là REST thuần. Không chỗ nào dùng WebSocket.

# ── IP thật của khách ───────────────────────────────────────────────────────
# Không khai gì ở đây, và đó là chủ ý.
#
# `set_real_ip_from` và `real_ip_header` trong cấu hình home nằm ở khối http,
# nên chúng áp dụng cho mọi server block của cả máy, kể cả hai cái dưới đây.
# Khai lại ở tệp này thì `set_real_ip_from` vô hại vì nó cộng dồn, nhưng
# `real_ip_header` là directive MỘT giá trị — khai hai lần cùng context là
# nginx từ chối khởi động:
#
#   nginx: [emerg] "real_ip_header" directive is duplicate
#
# Và nginx chết thì kéo theo cả home, không chỉ nexus.
#
# Hệ quả phải nhớ: nếu tệp home bị gỡ đi thì nexus lặng lẽ mất IP thật, mọi
# phiên đăng nhập ghi địa chỉ của Cloudflare. Lúc đó chuyển hai khối ấy sang
# khối http trong /etc/nginx/nginx.conf, chứ đừng chép vào cả hai tệp.

# ── Upstream ────────────────────────────────────────────────────────────────
upstream nexus_web { zone nexus_web 64k; server 127.0.0.1:4510; keepalive 2; }
upstream nexus_api { zone nexus_api 64k; server 127.0.0.1:4511; keepalive 2; }

# Tệp này tự chứa, không include snippet nào. Lặp lại tám dòng header proxy hai
# lần rẻ hơn nhiều so với việc quên chép một snippet lên rồi nginx không khởi
# động lại được.

# ── Đưa về HTTPS ────────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name nexus.nmtung.dev api-nexus.nmtung.dev;
    return 301 https://$host$request_uri;
}

# ── Trang web ───────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name nexus.nmtung.dev;
    server_tokens off;

    ssl_certificate /etc/nginx/keys/nginx-selfsigned.crt;
    ssl_certificate_key /etc/nginx/keys/nginx-selfsigned.key;
    ssl_session_cache builtin:1000 shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!eNULL:!EXPORT:!CAMELLIA:!DES:!MD5:!PSK:!RC4;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/nexus-web.access.log;
    client_max_body_size 2m;

    location / {
        # X-Forwarded-For đặt bằng $remote_addr chứ không phải
        # $proxy_add_x_forwarded_for: nhờ real_ip_header ở khối http, $remote_addr
        # đã là IP thật của khách. Dùng $proxy_add_ thì nó nối thêm cả chuỗi
        # khách tự gửi lên, mà .env để TRUST_PROXY=1 nghĩa là API chỉ bỏ qua
        # đúng một hop — khách sẽ tự khai được địa chỉ của mình.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        proxy_pass http://nexus_web;
    }
}

# ── API ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api-nexus.nmtung.dev;
    server_tokens off;

    ssl_certificate /etc/nginx/keys/nginx-selfsigned.crt;
    ssl_certificate_key /etc/nginx/keys/nginx-selfsigned.key;
    ssl_session_cache builtin:1000 shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!eNULL:!EXPORT:!CAMELLIA:!DES:!MD5:!PSK:!RC4;
    ssl_prefer_server_ciphers on;

    access_log /var/log/nginx/nexus-api.access.log;
    client_max_body_size 8m;

    # KHÔNG thêm header CORS ở đây. API tự đặt chúng theo đúng WEB_ORIGIN
    # trong .env. Nginx thêm một bộ nữa thì trình duyệt thấy hai dòng
    # Access-Control-Allow-Origin và chặn cả lượt gọi. Trả sẵn 204 cho OPTIONS
    # còn tệ hơn: preflight không bao giờ tới được API, nên phần kiểm origin
    # thật sự không chạy nữa và mọi trang web đều vượt qua được vòng đầu.
    #
    # Cookie phiên cũng không đụng vào. Hai tên miền cùng nằm dưới nmtung.dev
    # nên trình duyệt coi là same-site và SameSite=Lax vẫn cho cookie đi kèm
    # lời gọi từ nexus sang api-nexus.

    location / {
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        proxy_pass http://nexus_api;
    }
}
