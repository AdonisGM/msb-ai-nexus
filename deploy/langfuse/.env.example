# Langfuse tự dựng. Chép thành .env rồi điền.
#
# Bốn giá trị dưới đây sinh bằng lệnh, đừng nghĩ ra bằng tay:
#
#   SALT            openssl rand -base64 32
#   ENCRYPTION_KEY  openssl rand -hex 32      (phải đúng 64 ký tự hex)
#   NEXTAUTH_SECRET openssl rand -base64 32
#   các mật khẩu    openssl rand -hex 24
#
# Mật khẩu sinh bằng HEX, không phải base64. POSTGRES_PASSWORD bị ghép thẳng
# vào DATABASE_URL, mà base64 có ký tự `/` và `+` — gặp `/` là Prisma cắt URL
# sai chỗ rồi chết với:
#
#   P1013: invalid port number in database URL
#
# Hex chỉ có 0-9a-f nên an toàn trong URL. Dùng chung một cách cho cả bốn mật
# khẩu để khỏi phải nhớ cái nào nằm trong URL, cái nào không.
#
# ENCRYPTION_KEY dùng để mã hoá khoá API của từng dự án trong cơ sở dữ liệu.
# Mất nó là mất luôn các khoá đã lưu — sao lưu cùng chỗ với volume.

NEXTAUTH_URL=https://langfuse.nmtung.dev
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# Ghép vào DATABASE_URL — bắt buộc hex, xem ghi chú trên.
POSTGRES_PASSWORD=
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_USER=minio
MINIO_PASSWORD=

# Mở cổng cho ai. Mặc định chỉ chính máy chủ, nginx đứng trước.
BIND_ADDR=127.0.0.1
PORT_WEB=4520

# Bật lại tạm thời để tạo tài khoản đầu tiên, rồi đặt true và `up -d` lại.
AUTH_DISABLE_SIGNUP=false

# Langfuse gửi số liệu dùng ẩn danh về nhà. Tắt.
TELEMETRY_ENABLED=false

# ── Dựng sẵn ở lần chạy đầu ───────────────────────────────────────────────
# Điền để có ngay tổ chức, dự án, khoá và tài khoản quản trị mà không phải vào
# giao diện bấm tay. Chỉ chạy khi cơ sở dữ liệu còn trống.
#
# Hai khoá dưới là do BẠN đặt, không phải Langfuse sinh ra. Giữ đúng tiền tố
# pk-lf- và sk-lf-, phần đuôi sinh bằng: openssl rand -hex 16
INIT_ORG_ID=nmtung
INIT_ORG_NAME=nmtung.dev
INIT_PROJECT_ID=msb-ai-nexus
INIT_PROJECT_NAME=MSB AI Nexus
INIT_PUBLIC_KEY=pk-lf-
INIT_SECRET_KEY=sk-lf-
# Tài khoản đăng nhập trang quản trị. Đây là user/pass của bạn.
INIT_USER_EMAIL=
INIT_USER_NAME=
# Tối thiểu 8 ký tự. Người sau thì mời trong giao diện, không thêm ở đây.
INIT_USER_PASSWORD=
