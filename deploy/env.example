# .env của MÁY CHỦ. Khác tệp .env.example ở gốc repo, vốn là của máy phát triển.
#
#   cp env.example .env   rồi điền, rồi ./deploy.sh pull && ./deploy.sh up

# Kéo ảnh ở đâu về. Cần `docker login registry.marigate.org` một lần.
REGISTRY=registry.marigate.org
IMAGE_NS=nexus
# Ghim đúng bản đã kiểm. `latest` là bản đẩy gần nhất, tiện nhưng không biết
# mình đang chạy cái gì khi có sự cố.
TAG=daef78b

# Tên miền của TRANG WEB, không phải của API. API chỉ nhận cookie từ đúng
# origin này, và chính vì nó bắt đầu bằng https mà cookie phiên được gắn cờ
# Secure. Sai một ký tự là đăng nhập được nhưng lần gọi sau mất phiên.
WEB_ORIGIN=https://nexus.nmtung.dev

# Sinh mới, đừng dùng lại mật khẩu của máy phát triển:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Mật khẩu chung của sáu tài khoản vận hành, cho ./deploy.sh seed.
SEED_PASSWORD=

# Số proxy đứng trước. Một, là nginx. Để 0 thì cột ip trong bảng sessions
# ghi địa chỉ của nginx cho mọi phiên.
TRUST_PROXY=1

COOKIE_NAME=nexus_session
SESSION_TTL_DAYS=30
IDLE_TIMEOUT_MINUTES=0

# Bỏ trống tới khi dựng phần AI. Thiếu thì mọi màn khác vẫn chạy.
ANTHROPIC_API_KEY=
AI_MODE=live

# 127.0.0.1 nghĩa là chỉ nginx trên cùng máy nối được. Đổi thành 0.0.0.0 là
# phơi cả cơ sở dữ liệu ra Internet.
BIND_ADDR=127.0.0.1
PORT_WEB=4510
PORT_API=4511
PORT_DB=4513
