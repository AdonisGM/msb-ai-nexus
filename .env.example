# Database — port 5433 so it does not clash with the `home` project on 5432
DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# Session
COOKIE_NAME=nexus_session
IDLE_TIMEOUT_MINUTES=0
SESSION_TTL_DAYS=30

# Shared password for the five demo accounts, used by the seed script
SEED_PASSWORD=

# Claude — called from the API only, never exposed to the browser
ANTHROPIC_API_KEY=
# live: real calls · replay: serve stored answers, for rehearsals and filming
AI_MODE=live

# Tests run against a real Postgres, on a separate database on the same container
TEST_DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus_test

WEB_ORIGIN=http://localhost:5273
PORT=3100

# ── Chỉ dùng khi dựng ảnh: ./deploy.sh build ───────────────────────────────
# Máy chủ không đọc ba dòng này. VITE_API_BASE bị nướng cứng vào bundle web
# lúc build, nên đổi nó là phải dựng lại ảnh chứ không sửa được ở máy chủ.
REGISTRY=registry.marigate.org
IMAGE_NS=nexus
VITE_API_BASE=https://api-nexus.nmtung.dev

# Theo dõi lượt dùng AI: token, chi phí, độ trễ, tỉ lệ đọc từ cache.
# Bỏ trống thì trợ lý chạy y nguyên, chỉ là không đo được gì.
# Khoá lấy từ trang Settings của từng dự án trong Langfuse — mỗi dự án một cặp.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Bản tự dựng: http://langfuse-web:3000 nếu chung mạng docker, hoặc
# https://langfuse.nmtung.dev. Bỏ trống là trỏ về cloud EU của Langfuse.
LANGFUSE_BASE_URL=
