# Database — port 5433 so it does not clash with the `home` project on 5432
DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# Session
COOKIE_NAME=nexus_session
IDLE_TIMEOUT_MINUTES=0
SESSION_TTL_DAYS=30

# Shared password for the five demo accounts, used by the seed script
SEED_PASSWORD=

# Claude — called from the API only, never exposed to the browser
ANTHROPIC_API_KEY=
# live: real calls · replay: serve stored answers, for rehearsals and filming
AI_MODE=live

# Tests run against a real Postgres, on a separate database on the same container
TEST_DATABASE_URL=postgresql://nexus:nexus@localhost:5433/nexus_test

WEB_ORIGIN=http://localhost:5273
PORT=3100

# ── Chỉ dùng khi chạy thật trên máy chủ ────────────────────────────────────
# Máy phát triển không cần mấy biến này; deploy.sh sẽ đòi khi thiếu.

REGISTRY=registry.marigate.org
IMAGE_NS=nexus
# Nhãn ảnh. deploy.sh đặt bằng mã commit ngắn, "latest" là bản đẩy gần nhất.
TAG=latest

# Tên miền trang web, và gốc API mà trình duyệt gọi tới. Hai giá trị này phải
# khớp nhau: WEB_ORIGIN là thứ API cho phép gửi cookie tới, VITE_API_BASE là
# thứ được nướng vào bundle web lúc build.
WEB_ORIGIN=https://nexus.example.com
VITE_API_BASE=https://nexus-api.example.com

POSTGRES_PASSWORD=

# 127.0.0.1 nghĩa là chỉ máy chủ nối được, reverse proxy đứng trước. Đổi thành
# 0.0.0.0 là phơi thẳng ra Internet.
BIND_ADDR=127.0.0.1
PORT_WEB=4510
PORT_API=4511
PORT_DB=4513
